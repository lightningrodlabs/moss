{
  "name": "tests",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:one": "vitest --reporter=verbose -t 'Create expiring steward permission and retrieve it in different ways'",
    "test:group": "vitest --dir ./src/group/group run",
    "test:assets": "vitest --dir ./src/assets/assets run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts --project=smoke",
    "test:e2e:slow": "playwright test --config e2e/playwright.config.ts --project=slow",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:clean": "node e2e/scripts/clean-profiles.cjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@holochain/client": "^0.21.0",
    "@holochain-open-dev/tryorama": "^0.20.0-rc.0",
    "@holochain-open-dev/utils": "^0.700.0",
    "@theweave/group-client": "^0.7.0-dev.0",
    "@theweave/api": "^0.7.0-dev.0",
    "typescript": "^5.8.3",
    "vitest": "^0.28.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^18.17.5"
  },
  "type": "module"
}
